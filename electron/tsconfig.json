{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "../dist-electron",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["./**/*.ts", "./**/*.cts"],
  "exclude": ["./**/*.test.ts"]
}
